{
	"name": "init/commerce-photon",
	"version": "dev-main",
	"description": "Photon integration package for init commerce foundation packages",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Init",
			"email": "dev@init.com"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://satis.init.red"
		}
	],
	"require": {
		"php": "^8.4",
		"laravel/framework": "^12.0",
		"init/commerce-cart": "^1",
		"init/commerce-catalog": "^1",
		"init/commerce-order": "^1",
		"init/photon": "^1.0",
		"spatie/laravel-package-tools": "^1.16"
	},
	"autoload": {
		"psr-4": {
			"Init\\CommercePhoton\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": ["Init\\CommercePhoton\\RootServiceProvider"]
		},
		"merge-plugin": {
			"include": ["composer.local.json"],
			"recurse": true,
			"replace": true,
			"ignore-duplicates": false,
			"merge-dev": true,
			"merge-extra": false,
			"merge-extra-deep": false,
			"merge-scripts": false
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"require-dev": {
		"orchestra/testbench": "^10.0",
		"pestphp/pest": "^4.2",
		"pestphp/pest-plugin-laravel": "^4.0"
	}
}
